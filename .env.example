# Pooled PostgreSQL URL used by the application (add ?sslmode=require when your provider requires it)
DATABASE_URL="postgresql://user:password@host/database?sslmode=require"

# The conference label stored with every lead and shown on the landing page
EVENT_NAME="Conference 2026"

# Private team-area credentials. Use long, unique values in production.
ADMIN_PASSWORD="replace-with-a-long-password"
SESSION_SECRET="replace-with-at-least-32-random-characters"
